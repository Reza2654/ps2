{
  "name": "ps2-vscode",
  "displayName": "PowerScript 2 (ps2) Language Support",
  "description": "Rich syntax highlighting, pipeline operators, and capability manifest support for PowerScript 2 (.ps2)",
  "version": "0.1.0",
  "publisher": "PowerScript2",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ps2",
        "aliases": [
          "PowerScript 2",
          "ps2"
        ],
        "extensions": [
          ".ps2",
          ".ps2bundle"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ps2",
        "scopeName": "source.ps2",
        "path": "./syntaxes/ps2.tmLanguage.json"
      }
    ]
  }
}
