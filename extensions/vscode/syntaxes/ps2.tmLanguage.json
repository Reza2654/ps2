{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PowerScript 2",
  "scopeName": "source.ps2",
  "patterns": [
    { "include": "#shebang" },
    { "include": "#comments" },
    { "include": "#manifest" },
    { "include": "#signature" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#algebraic_types" },
    { "include": "#builtins" },
    { "include": "#operators" },
    { "include": "#numbers" },
    { "include": "#function_calls" },
    { "include": "#constants" }
  ],
  "repository": {
    "shebang": {
      "match": "^#!.*$",
      "name": "comment.line.shebang.ps2"
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ps2",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ps2",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "manifest": {
      "patterns": [
        {
          "match": "\\b(#manifest|#endmanifest)\\b",
          "name": "keyword.control.directive.manifest.ps2"
        },
        {
          "match": "\\b(requires)\\b",
          "name": "keyword.other.manifest.requires.ps2"
        },
        {
          "match": "\\b(fs\\.read|fs\\.write|net\\.http|env|proc\\.exec)\\b",
          "name": "support.type.capability.ps2"
        }
      ]
    },
    "signature": {
      "match": "^\\s*(#signature:)\\s*(.*)$",
      "captures": {
        "1": { "name": "keyword.control.directive.signature.ps2" },
        "2": { "name": "constant.character.hash.ps2" }
      }
    },
    "strings": {
      "name": "string.quoted.double.ps2",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.ps2",
          "match": "\\\\."
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "storage.type.ps2",
          "match": "\\b(let|mut|fn|async|await)\\b"
        },
        {
          "name": "keyword.control.ps2",
          "match": "\\b(if|else|while|for|in|match|return|as)\\b"
        }
      ]
    },
    "algebraic_types": {
      "patterns": [
        {
          "name": "entity.name.type.algebraic.ps2",
          "match": "\\b(Some|None|Ok|Err)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.ps2",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.class.module.ps2",
          "match": "\\b(fs|net|json|str|sys|path|time|table|math)\\b"
        },
        {
          "name": "support.function.builtin.ps2",
          "match": "\\b(println|print|len|map|filter|reduce|sort|take|unwrap|unwrap_or|is_some|is_none|is_ok|is_err)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipe.ps2",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.arrow.ps2",
          "match": "=>|->"
        },
        {
          "name": "keyword.operator.comparison.ps2",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.ps2",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.ps2",
          "match": "\\+=|-=|="
        },
        {
          "name": "keyword.operator.arithmetic.ps2",
          "match": "\\+|-|\\*|/|%"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.ps2",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.ps2",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "function_calls": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.ps2" }
      }
    }
  }
}
